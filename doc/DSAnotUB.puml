@startuml

class AnotUB  {
    margeBenefici: Quantity
}

class Empresa  {
    nom: String
    núm: int
    vat: String
}


class Pais{
    nom: String
}

class CompteBancari{
    IBAN: String
    Swift: String
}

class Passaport{
    nom: String
    cognom1: String
    cognom2: String
    númIdentificatiu: String
    dataCaducitat: Date
}

class Anotador  {
    nomUsuari: String
    contrasenya: String
}

class InfoObligatoria{
    email: String
    telèfon: String
}

class Tasca  {
    titol: String
    instruccions: String
    dataLimit: Date
    remuneracióPerDada: Quantity
    remuneració: Quantity
}

abstract Dada  {
    anotada: Boolean
}

class Imatge  {
    amplada: int
    alçada: int
    pixels: List<int,int,int,int,int>
}

abstract EstatTasca {
}

class EstatTascaPendent{
}

class EstatTascaAssignada{
}

class EstatTascaCompletada{
}

class Document  {
    text: String
}

class Categoria  {
    nom: String
}

class LocalitzacióObjecte  {
    id: int
}

class Expertesa  {
    nom: String
}

AnotUB "1" -- "1..*" Tasca: publica >
AnotUB "1" -- "*" Anotador: disposaDe >

Empresa "1" -- "1..*" Tasca: enviadaPer <
Empresa "*" -- "1" Pais: pais-residencia-fiscal <


Anotador "*" -- "*"  Expertesa: declara >
Anotador "1" -- "1..*" CompteBancari: té >
Anotador "1" -- "1" Passaport: té >
Passaport "0..*" -- "1" Pais: pais-expedició <


Categoria "*" -l- "*" Dada: anota >
LocalitzacióObjecte "0..*" -r- "1" Imatge: anota >
LocalitzacióObjecte "*" -- "1" Categoria: classifica >

InfoObligatoria "1" -- "1" Anotador: té <
InfoObligatoria "1" -- "1" Empresa: té <


Imatge -u-|> Dada
Document -u-|> Dada
EstatTascaPendent -u-|> EstatTasca
EstatTascaAssignada -u-|> EstatTasca
EstatTascaCompletada -u-|> EstatTasca

Tasca "1" -- "1..*" Dada: involucra >

Tasca "1" -r- "1" EstatTasca: té >

Tasca "1..*" -- "1" Expertesa: declara >

Tasca "*" -- "0..1" Anotador: assignada a >

@enduml
